# ThreatForge Environment Configuration Template
# Copy this file to .env for local development

# Environment: development, staging, production
ENVIRONMENT=development

# Backend Database URL
# Local SQLite default:
DATABASE_URL=sqlite:///./threatforge.db
# For production PostgreSQL (e.g. Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/threatforge

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# API Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security Limits
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration (for frontend .env)
# VITE_API_BASE_URL=http://localhost:8000/api
